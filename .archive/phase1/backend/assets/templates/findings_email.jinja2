<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Legal Findings Letter - {{ client_name }}</title>
    <style>
        body { font-family: 'Times New Roman', serif; line-height: 1.6; color: #333; margin: 40px; }
        .header { text-align: center; margin-bottom: 30px; }
        .section { margin-bottom: 25px; }
        .section h2 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 5px; }
        .highlight { background-color: #f8f9fa; padding: 15px; border-left: 4px solid #3498db; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Legal Analysis and Findings Letter</h1>
        <p><strong>Client:</strong> {{ client_name }}</p>
        <p><strong>Case Type:</strong> {{ case_type }}</p>
        <p><strong>Date:</strong> {{ date }}</p>
    </div>
    
    <div class="content">
        {{ letter_content | safe }}
    </div>
</body>
</html>