# Environment Variables Example
# Copy this file to .env and replace the example values with your actual credentials
# NEVER commit the actual .env file to version control!

# ==================================================
# REQUIRED API KEYS
# ==================================================

# OpenAI API Key - Required for AI analysis and email generation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-example1234567890abcdefghijklmnopqrstuvwxyz

# ==================================================
# GOOGLE CLOUD CONFIGURATION (for Video Processing)
# ==================================================

# Google Cloud Project ID - Required for video analysis features
# Find your project ID in Google Cloud Console
GCP_PROJECT_ID=my-legal-analysis-project

# Google Cloud Storage Bucket Name - Required for temporary video storage
# Create a bucket in Google Cloud Storage for video processing
GCP_BUCKET_NAME=my-legal-videos-bucket

# Google Application Credentials - Path to your service account JSON file
# Download from Google Cloud Console > IAM & Admin > Service Accounts
# Required roles: Vertex AI User, Storage Object Admin, Speech Service Agent
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# ==================================================
# OPTIONAL CONFIGURATION
# ==================================================

# Railway-specific variables (automatically set by Railway in production)
# PORT=8501
# RAILWAY_STATIC_URL=https://your-app.railway.app