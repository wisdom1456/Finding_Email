# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!

# ==================================================
# REQUIRED API KEYS
# ==================================================

# OpenAI API Key - Required for AI analysis and email generation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ==================================================
# GOOGLE CLOUD CONFIGURATION (for Video Processing)
# ==================================================

# Google Cloud Project ID - Required for video analysis features
# Find your project ID in Google Cloud Console
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Storage Bucket Name - Required for temporary video storage
# Create a bucket in Google Cloud Storage for video processing
GCP_BUCKET_NAME=your-gcs-bucket-name

# Google Application Credentials - Path to your service account JSON file
# Download from Google Cloud Console > IAM & Admin > Service Accounts
# Required roles: Vertex AI User, Storage Object Admin, Speech Service Agent
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-file.json

# ==================================================
# OPTIONAL CONFIGURATION
# ==================================================

# Environment detection (set automatically by deployment platforms)
# VERCEL_ENV=production|preview|development  (set by Vercel)
# RAILWAY_STATIC_URL=<set-by-railway>
# Override manually if needed:
# ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Worker Monitoring & Alerting
# ---------------------------------------------------------------------------

# Slack Incoming Webhook URL (or any HTTP POST endpoint that accepts JSON)
# Get from: Slack → Your App → Incoming Webhooks → Add New Webhook
# If unset, alerts are logged but not sent externally.
ALERT_WEBHOOK_URL=

# Railway personal API token for auto-redeploy on zombie detection.
# Get from: https://railway.app/account/tokens
# If unset, auto-redeploy is disabled (alerts still fire).
RAILWAY_API_TOKEN=

# Railway service and environment identifiers for this project.
# Override only if targeting a different Railway service.
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=

# Vercel auto-generates CRON_SECRET. Pull it with: vercel env pull .env.local
# Set here for manual invocations of the /api/monitor/worker endpoint.
CRON_SECRET=
