# Vercel Ignore - Exclude these from FINAL deployment only
# Note: Files are needed for BUILD, but can be excluded from final deployment

# Python cache (never needed)
*.pyc
__pycache__/
*.pyo
*.pyd
.Python

# Python testing (not needed)
tests/*.py
pytest.ini
.pytest_cache/

# Documentation (not needed in production)
docs/
*.md
!README.md
!src/legal_portal/prompts/jurisdiction_guidance/*.md
LICENSE
CHANGELOG*

# IDE files (never needed)
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs and debug data (not needed)
logs/
debug_output/
cost_sessions/
output/
validation_output/

# Memory bank (development only)
memory-bank/

# Environment files (managed via Vercel dashboard)
.env
.env.*
!.env.example

# Git metadata (never needed)
.git/
.gitignore
.gitattributes

# Keep vercel_build.sh, exclude other scripts
scripts/*
!scripts/vercel_build.sh
Makefile

# Legal corpus files - both jurisdictions needed for statute validation
# Note: Keep these deployed until migrated to database
# florida_legal_corpus/ - DEPLOYED
# new_mexico_legal_corpus/ - DEPLOYED

# Test data (not needed)
test_data/
test_data_old/
test_data_v2/

# Reports (not needed)
reports/
prompt_versions/
schemas/

# Docker files (not used on Vercel)
Dockerfile*
docker-compose*.yml
cloudbuild.yaml

# Git worktrees (development only, ~100MB+)
.worktrees/

# Python virtual environments (not needed)
venv/
env/
.venv/

# Python build artifacts (not needed)
build/
dist/
*.egg-info/

# Supabase migrations (run manually, not needed in deployment)
supabase/migrations/

# Note: DO NOT exclude frontend/src/ - it's needed to build!
# Note: DO NOT exclude api/ source - it's needed to run!
# The build process will create the final output in .vercel/output/
