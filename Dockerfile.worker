FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/src

RUN apt-get update && \
    apt-get install -y --no-install-recommends libmagic1 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY worker/ worker/
# Statute corpora — without these, citation validation silently treats every
# citation as unverified (StatuteValidationService resolves them by walking
# up from src/legal_portal to /app).
COPY florida_legal_corpus/ florida_legal_corpus/
COPY new_mexico_legal_corpus/ new_mexico_legal_corpus/

HEALTHCHECK --interval=60s --timeout=10s CMD pgrep -f analysis_worker || exit 1

CMD ["python", "-m", "worker.analysis_worker"]
