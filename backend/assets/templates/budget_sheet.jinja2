<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Legal Case Budget Report</title>
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .letterhead {
            text-align: left;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #2c3e50;
        }
        .letterhead h1 {
            font-family: 'Georgia', serif;
            color: #2c3e50;
            font-size: 24px;
            margin: 0 0 10px 0;
        }
        .header-info {
            margin-bottom: 30px;
            font-size: 14px;
        }
        .header-info p {
            margin: 5px 0;
        }
        .section {
            margin-bottom: 30px;
            page-break-inside: avoid;
        }
        .section h2 {
            font-family: 'Georgia', serif;
            color: #2c3e50;
            font-size: 18px;
            margin-bottom: 15px;
            padding-bottom: 5px;
            border-bottom: 1px solid #bdc3c7;
        }
        .section h3 {
            font-family: 'Georgia', serif;
            color: #34495e;
            font-size: 16px;
            margin-bottom: 10px;
            margin-top: 20px;
        }

        /* Budget-specific styles */
        .budget-summary {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
            margin-bottom: 20px;
            border-left: 4px solid #2c3e50;
        }

        .cost-comparison {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .cost-box {
            padding: 15px;
            border-radius: 5px;
            text-align: center;
            border: 1px solid #ddd;
        }

        .estimated-cost {
            background-color: #e8f4f8;
            border-left: 4px solid #3498db;
        }

        .actual-cost {
            background-color: #f0f8e8;
            border-left: 4px solid #27ae60;
        }

        .variance-box {
            padding: 15px;
            border-radius: 5px;
            margin: 10px 0;
            text-align: center;
            font-weight: bold;
        }

        .variance-good {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .variance-warning {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
        }

        .variance-danger {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f1c6cb;
        }

        .cost-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
            font-size: 13px;
        }

        .cost-table th,
        .cost-table td {
            padding: 8px 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .cost-table th {
            background-color: #f8f9fa;
            font-weight: bold;
            color: #2c3e50;
            border-bottom: 2px solid #2c3e50;
        }

        .cost-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .cost-table .currency {
            text-align: right;
            font-family: 'Courier New', monospace;
        }

        .service-breakdown {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .service-card {
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 15px;
            background-color: #fafafa;
        }

        .service-card h4 {
            margin: 0 0 10px 0;
            color: #2c3e50;
            font-size: 14px;
        }

        .percentage-bar {
            width: 100%;
            height: 8px;
            background-color: #ecf0f1;
            border-radius: 4px;
            margin: 5px 0;
            overflow: hidden;
        }

        .percentage-fill {
            height: 100%;
            background-color: #3498db;
            transition: width 0.3s ease;
        }

        .insights-section {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
            border-left: 4px solid #f39c12;
        }

        .recommendations-list {
            list-style-type: none;
            padding: 0;
        }

        .recommendations-list li {
            margin: 10px 0;
            padding: 10px;
            background-color: #e8f4f8;
            border-left: 3px solid #3498db;
            border-radius: 3px;
        }

        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #bdc3c7;
            font-style: italic;
            font-size: 12px;
            color: #7f8c8d;
        }

        .highlight-number {
            font-family: 'Georgia', serif;
            font-size: 18px;
            font-weight: bold;
            color: #2c3e50;
        }

        @media print {
            .container {
                box-shadow: none;
                padding: 20px;
            }
            .section {
                page-break-inside: avoid;
            }
            .cost-comparison {
                grid-template-columns: 1fr;
            }
            .service-breakdown {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .cost-comparison {
                grid-template-columns: 1fr;
            }
            .service-breakdown {
                grid-template-columns: 1fr;
            }
            .container {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header Section -->
        <div class="letterhead">
            <h1>Legal Case Budget Report</h1>
        </div>

        <div class="header-info">
            <p><strong>Case ID:</strong> {{ cost_summary.case_id }}</p>
            <p><strong>Report Generated:</strong> {{ report_timestamp.strftime('%B %d, %Y at %I:%M %p') }}</p>
            {% if cost_summary.cost_estimate %}
            <p><strong>Estimation Date:</strong> {{ cost_summary.cost_estimate.estimation_timestamp.strftime('%B %d, %Y at %I:%M %p') }}</p>
            <p><strong>Confidence Level:</strong> {{ (cost_summary.cost_estimate.confidence_level * 100)|round(1) }}%</p>
            {% endif %}
        </div>

        <!-- Executive Summary -->
        <div class="section">
            <h2>Executive Summary</h2>
            <div class="budget-summary">
                {% if cost_summary.cost_estimate and cost_summary.actual_costs %}
                <div class="cost-comparison">
                    <div class="cost-box estimated-cost">
                        <h3>Estimated Cost</h3>
                        <div class="highlight-number">{{ format_currency(cost_summary.cost_estimate.total_estimated_cost) }}</div>
                    </div>
                    <div class="cost-box actual-cost">
                        <h3>Actual Cost</h3>
                        <div class="highlight-number">{{ format_currency(cost_summary.actual_costs.total_actual_cost) }}</div>
                    </div>
                </div>

                {% if cost_summary.cost_variance is not None %}
                <div class="variance-box {% if variance_indicators.status == 'good' %}variance-good{% elif variance_indicators.status == 'caution' %}variance-warning{% else %}variance-danger{% endif %}">
                    <div>Cost Variance: {{ format_currency(cost_summary.cost_variance) }} ({{ format_percentage(cost_summary.cost_variance_percentage) }})</div>
                    <div>Status: {{ variance_indicators.status|title }}</div>
                </div>
                {% endif %}

                {% elif cost_summary.cost_estimate %}
                <div class="cost-box estimated-cost">
                    <h3>Estimated Cost</h3>
                    <div class="highlight-number">{{ format_currency(cost_summary.cost_estimate.total_estimated_cost) }}</div>
                    <p><em>Processing not yet completed</em></p>
                </div>
                {% elif cost_summary.actual_costs %}
                <div class="cost-box actual-cost">
                    <h3>Total Processing Cost</h3>
                    <div class="highlight-number">{{ format_currency(cost_summary.actual_costs.total_actual_cost) }}</div>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Cost Breakdown Details -->
        {% if cost_summary.cost_estimate %}
        <div class="section">
            <h2>Cost Estimates</h2>
            <h3>Document Processing Estimates</h3>
            {% if cost_summary.cost_estimate.estimated_document_costs %}
            <table class="cost-table">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Operation</th>
                        <th>File</th>
                        <th>Units</th>
                        <th>Rate</th>
                        <th>Cost</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cost in cost_summary.cost_estimate.estimated_document_costs %}
                    <tr>
                        <td>{{ cost.service_name }}</td>
                        <td>{{ cost.operation_type }}</td>
                        <td>{{ cost.file_name or 'N/A' }}</td>
                        <td>{{ cost.units_consumed }} {{ cost.unit_type }}</td>
                        <td class="currency">${{ "%.6f"|format(cost.rate_per_unit) }}</td>
                        <td class="currency">{{ format_currency(cost.total_cost) }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p><em>No document processing costs estimated.</em></p>
            {% endif %}

            <h3>Media Processing Estimates</h3>
            {% if cost_summary.cost_estimate.estimated_media_costs %}
            <table class="cost-table">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Operation</th>
                        <th>File</th>
                        <th>Units</th>
                        <th>Rate</th>
                        <th>Cost</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cost in cost_summary.cost_estimate.estimated_media_costs %}
                    <tr>
                        <td>{{ cost.service_name }}</td>
                        <td>{{ cost.operation_type }}</td>
                        <td>{{ cost.file_name or 'N/A' }}</td>
                        <td>{{ cost.units_consumed }} {{ cost.unit_type }}</td>
                        <td class="currency">${{ "%.6f"|format(cost.rate_per_unit) }}</td>
                        <td class="currency">{{ format_currency(cost.total_cost) }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p><em>No media processing costs estimated.</em></p>
            {% endif %}
        </div>
        {% endif %}

        <!-- Actual Costs -->
        {% if cost_summary.actual_costs %}
        <div class="section">
            <h2>Actual Costs Incurred</h2>
            <h3>Document Analysis Costs</h3>
            {% if cost_summary.actual_costs.document_analysis_costs %}
            <table class="cost-table">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Operation</th>
                        <th>File</th>
                        <th>Units</th>
                        <th>Rate</th>
                        <th>Cost</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cost in cost_summary.actual_costs.document_analysis_costs %}
                    <tr>
                        <td>{{ cost.service_name }}</td>
                        <td>{{ cost.operation_type }}</td>
                        <td>{{ cost.file_name or 'N/A' }}</td>
                        <td>{{ cost.units_consumed }} {{ cost.unit_type }}</td>
                        <td class="currency">${{ "%.6f"|format(cost.rate_per_unit) }}</td>
                        <td class="currency">{{ format_currency(cost.total_cost) }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p><em>No document analysis costs incurred.</em></p>
            {% endif %}

            <h3>Media Processing Costs</h3>
            {% if cost_summary.actual_costs.media_processing_costs %}
            <table class="cost-table">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Operation</th>
                        <th>File</th>
                        <th>Units</th>
                        <th>Rate</th>
                        <th>Cost</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cost in cost_summary.actual_costs.media_processing_costs %}
                    <tr>
                        <td>{{ cost.service_name }}</td>
                        <td>{{ cost.operation_type }}</td>
                        <td>{{ cost.file_name or 'N/A' }}</td>
                        <td>{{ cost.units_consumed }} {{ cost.unit_type }}</td>
                        <td class="currency">${{ "%.6f"|format(cost.rate_per_unit) }}</td>
                        <td class="currency">{{ format_currency(cost.total_cost) }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p><em>No media processing costs incurred.</em></p>
            {% endif %}
        </div>
        {% endif %}

        <!-- Service Breakdown -->
        {% if service_breakdown %}
        <div class="section">
            <h2>Service Cost Distribution</h2>
            <div class="service-breakdown">
                {% for service_name, data in service_breakdown.items() %}
                <div class="service-card">
                    <h4>{{ service_name }}</h4>
                    <p><strong>Cost:</strong> {{ format_currency(data.total_cost) }}</p>
                    <p><strong>Share:</strong> {{ format_percentage(data.percentage) }}</p>
                    <p><strong>Units:</strong> {{ data.units_consumed }}</p>
                    <div class="percentage-bar">
                        <div class="percentage-fill" style="width: {{ data.percentage }}%"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- Variance Analysis -->
        {% if cost_summary.cost_variance is not None %}
        <div class="section">
            <h2>Variance Analysis</h2>
            <div class="budget-summary">
                <p><strong>Cost Variance:</strong> {{ format_currency(cost_summary.cost_variance) }}</p>
                <p><strong>Percentage Variance:</strong> {{ format_percentage(cost_summary.cost_variance_percentage) }}</p>

                {% if cost_summary.cost_variance_percentage > 15 %}
                <p><strong>Analysis:</strong> Actual costs significantly exceeded estimates. This suggests that the case complexity was higher than initially assessed, or that additional processing steps were required beyond the original scope.</p>
                {% elif cost_summary.cost_variance_percentage > 5 %}
                <p><strong>Analysis:</strong> Actual costs exceeded estimates moderately. This is within an acceptable range for complex legal cases but suggests estimation models could be refined.</p>
                {% elif cost_summary.cost_variance_percentage > -5 %}
                <p><strong>Analysis:</strong> Actual costs were very close to estimates, indicating accurate forecasting and efficient case processing.</p>
                {% elif cost_summary.cost_variance_percentage > -15 %}
                <p><strong>Analysis:</strong> Actual costs came in under estimates, suggesting efficient processing or that the case was less complex than initially assessed.</p>
                {% else %}
                <p><strong>Analysis:</strong> Actual costs were significantly under estimates, indicating either very efficient processing or conservative estimation models.</p>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <!-- Budget Insights -->
        {% if budget_analysis.insights %}
        <div class="section">
            <h2>Operational Insights</h2>
            <div class="insights-section">
                <ul>
                    {% for insight in budget_analysis.insights %}
                    <li>{{ insight }}</li>
                    {% endfor %}
                </ul>

                {% if budget_analysis.cost_efficiency_score %}
                <p><strong>Cost Efficiency Rating:</strong> {{ budget_analysis.cost_efficiency_score }}</p>
                {% endif %}

                {% if budget_analysis.budget_compliance %}
                <p><strong>Budget Compliance:</strong> {{ budget_analysis.budget_compliance }}</p>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <!-- Recommendations -->
        {% if recommendations %}
        <div class="section">
            <h2>Recommendations</h2>
            <ul class="recommendations-list">
                {% for recommendation in recommendations %}
                <li>{{ recommendation }}</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        <!-- Optimization Opportunities -->
        {% if budget_analysis.optimization_opportunities %}
        <div class="section">
            <h2>Cost Optimization Opportunities</h2>
            <ul>
                {% for opportunity in budget_analysis.optimization_opportunities %}
                <li>{{ opportunity }}</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        <!-- Footer -->
        <div class="footer">
            <p><strong>Report Generated:</strong> {{ report_timestamp.strftime('%Y-%m-%d %H:%M:%S') }} | Legal Document Analysis Portal</p>
            <p><strong>Disclaimer:</strong> This cost analysis is based on actual API usage and processing metrics.
            Costs are calculated using current pricing rates and may be subject to change based on service provider updates.
            This report is for internal operational analysis and budget planning purposes.</p>
        </div>
    </div>
</body>
</html>
