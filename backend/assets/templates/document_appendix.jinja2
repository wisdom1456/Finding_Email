<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document Review Appendix</title>
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px;
        }
        .header {
            text-align: left;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #333;
        }
        .header h1 {
            font-family: 'Georgia', serif;
            color: #333;
            font-size: 24px;
            margin: 0 0 10px 0;
        }
        .document-item {
            border: 1px solid #ddd;
            margin-bottom: 20px;
            padding: 20px;
        }
        .document-header {
            color: #333;
            padding: 10px 15px;
            margin: -20px -20px 15px -20px;
            border-bottom: 2px solid #333;
        }
        .document-header h4 {
            margin: 0;
            font-family: 'Georgia', serif;
            font-size: 16px;
        }
        .document-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 15px;
        }
        .meta-item {
            padding: 10px;
            border-left: 2px solid #333;
        }
        .meta-label {
            font-weight: bold;
            color: #333;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 3px;
        }
        .meta-value {
            color: #333;
            font-size: 14px;
        }
        .document-content {
            margin-top: 15px;
        }
        .document-content h5 {
            color: #333;
            margin-bottom: 8px;
            font-family: 'Georgia', serif;
        }
        .document-content p {
            margin-bottom: 12px;
            text-align: justify;
        }
        @media print {
            .container {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header Section -->
        <div class="header">
            <h1>Document Review Appendix</h1>
            <p>The following documents were analyzed as part of this case review:</p>
        </div>

        <!-- Case Timeline Section -->
        {% if results.case_timeline %}
        <div style="margin-bottom: 40px; padding-bottom: 30px; border-bottom: 2px solid #333;">
            <div class="header">
                <h1>Case Timeline</h1>
                <p>Key events extracted chronologically from all available sources:</p>
            </div>

            {% for event in results.case_timeline %}
            <div style="margin-bottom: 20px; padding: 15px; border-left: 4px solid #3498db; background-color: #f8f9fa; border-radius: 0 5px 5px 0;">
                <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 15px; margin-bottom: 10px;">
                    <div class="meta-item">
                        <div class="meta-label">Date</div>
                        <div class="meta-value" style="font-weight: bold; color: #2c3e50;">{{ event.date }}</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Source</div>
                        <div class="meta-value">{{ event.source }}</div>
                    </div>
                </div>
                <div style="margin-top: 10px;">
                    <div class="meta-label">Event Description</div>
                    <p style="margin: 5px 0; font-size: 14px; line-height: 1.4;">{{ event.event }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Document List -->
        {% if results.analysis and results.analysis.analyzed_documents %}
        {% for document in results.analysis.analyzed_documents %}
        <div class="document-item">
            <div class="document-header">
                <h4>{{ document.filename }}</h4>
            </div>

            <div class="document-meta">
                <div class="meta-item">
                    <div class="meta-label">Document Type</div>
                    <div class="meta-value">{{ document.document_type | default('Not Specified') }}</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Inferred Title</div>
                    <div class="meta-value">{{ document.inferred_title | default('Not Available') }}</div>
                </div>
            </div>

            <div class="document-content">
                <h5>Summary</h5>
                <p>{{ document.summary | default('No summary available.') }}</p>

                <h5>Key Information</h5>
                <p>{{ document.key_information | default('No key information identified.') }}</p>

                <h5>Relevance to Case</h5>
                <p>{{ document.relevance_to_case | default('Relevance not determined.') }}</p>

                {% if document.legal_significance %}
                <h5>Legal Significance</h5>
                <p>{{ document.legal_significance }}</p>
                {% endif %}

                {% if document.citations %}
                <h5>Document Citations</h5>
                <div style="background-color: #f8f9fa; padding: 15px; margin: 10px 0; border-left: 4px solid #17a2b8;">
                    {% for citation in document.citations %}
                    <div style="margin-bottom: 10px; padding: 8px; background-color: white; border-radius: 3px;">
                        {% if citation.page_number %}
                        <div style="font-weight: bold; color: #2c3e50; margin-bottom: 5px;">Page {{ citation.page_number }}</div>
                        {% endif %}
                        {% if citation.text %}
                        <div style="font-style: italic; margin-bottom: 5px;">"{{ citation.text }}"</div>
                        {% endif %}
                        {% if citation.context %}
                        <div style="font-size: 13px; color: #6c757d;">{{ citation.context }}</div>
                        {% endif %}
                        {% if citation.significance %}
                        <div style="font-size: 13px; color: #28a745; margin-top: 5px;"><strong>Significance:</strong> {{ citation.significance }}</div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
        {% else %}
        <div class="document-item">
            <p>No documents were analyzed for this case review.</p>
        </div>
        {% endif %}

        <!-- Video Evidence Analysis Section -->
        {% if results.analysis and results.analysis.video_insights %}
        <div style="margin-top: 40px; padding-top: 30px; border-top: 2px solid #333;">
            <div class="header">
                <h1>Video Evidence Analysis</h1>
                <p>The following video evidence was analyzed as part of this case review:</p>
            </div>

            {% for video in results.analysis.video_insights %}
            <div class="document-item" style="margin-bottom: 30px;">
                <div class="document-header">
                    <h4>{{ video.file_name }}</h4>
                </div>

                <!-- Check if this is an enhanced video insight with criminal analysis -->
                {% if video.is_criminal_case and video.criminal_analysis %}
                <div style="margin-bottom: 20px;">
                    <h5 style="color: #333; margin-bottom: 10px; font-family: 'Georgia', serif;">Criminal Law Evidence Analysis</h5>

                    <!-- Timeline Summary -->
                    <div style="background-color: #f8f9fa; padding: 15px; margin-bottom: 15px; border-left: 4px solid #333;">
                        <div class="meta-label">Timeline Summary</div>
                        <p style="margin: 5px 0;">{{ video.criminal_analysis.timeline_summary }}</p>
                    </div>

                    <!-- Constitutional Compliance Overview -->
                    {% if video.criminal_analysis.constitutional_issues %}
                    <div style="background-color: #f8f9fa; padding: 15px; margin-bottom: 20px; border-left: 4px solid #333;">
                        <div class="meta-label">Constitutional Compliance Overview</div>
                        {% for amendment, issues in video.criminal_analysis.constitutional_issues.items() %}
                            <div style="margin-bottom: 10px;">
                                <strong style="color: #2c3e50;">{{ amendment | replace('_', ' ') | title }}:</strong>
                                {% if issues is string %}
                                    <p style="margin: 3px 0; font-size: 13px;">{{ issues }}</p>
                                {% elif issues is mapping %}
                                    {% for key, value in issues.items() %}
                                        <p style="margin: 3px 0; font-size: 13px;"><strong>{{ key | replace('_', ' ') | title }}:</strong> {{ value }}</p>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    <!-- Evidence Items by Category -->
                    {% if video.criminal_analysis.evidence_categories %}
                    <h5 style="color: #333; margin-bottom: 15px; font-family: 'Georgia', serif;">Timestamped Evidence Categories</h5>

                    {% for evidence in video.criminal_analysis.evidence_categories %}
                    <div style="border: 1px solid #ddd; margin-bottom: 15px; padding: 15px; background-color: #fdfdfd;">
                        <h6 style="color: #333; margin: 0 0 10px 0; font-family: 'Georgia', serif; font-size: 14px;">
                            {{ evidence.category_number }}. {{ evidence.category }}
                        </h6>

                        <div class="document-meta" style="margin-bottom: 10px;">
                            <div class="meta-item">
                                <div class="meta-label">Evidence Found</div>
                                <div class="meta-value" style="font-weight: bold; color: {{ 'green' if evidence.evidence_found else 'red' }};">
                                    {{ "Yes" if evidence.evidence_found else "No" }}
                                </div>
                            </div>
                            {% if evidence.evidence_found and evidence.timestamp %}
                            <div class="meta-item">
                                <div class="meta-label">Timestamp</div>
                                <div class="meta-value">{{ evidence.timestamp }}</div>
                            </div>
                            {% endif %}
                        </div>

                        {% if evidence.evidence_found %}
                        <div style="margin-bottom: 10px;">
                            <div class="meta-label">Evidence Strength</div>
                            <div class="meta-value" style="text-transform: capitalize; font-weight: bold; color: {{ '#27ae60' if evidence.strength == 'strong' else '#f39c12' if evidence.strength == 'moderate' else '#e74c3c' }};">
                                {{ evidence.strength }}
                            </div>
                        </div>

                        <div style="margin-bottom: 10px;">
                            <div class="meta-label">Description</div>
                            <p style="margin: 3px 0; font-size: 13px;">{{ evidence.description }}</p>
                        </div>

                        <div style="margin-bottom: 10px;">
                            <div class="meta-label">Legal Significance</div>
                            <p style="margin: 3px 0; font-size: 13px; font-style: italic;">{{ evidence.legal_significance }}</p>
                        </div>

                        {% if evidence.constitutional_implications %}
                        <div style="margin-bottom: 10px;">
                            <div class="meta-label">Constitutional Implications</div>
                            <p style="margin: 3px 0; font-size: 13px; color: #d32f2f;">{{ evidence.constitutional_implications }}</p>
                        </div>
                        {% endif %}
                        {% endif %}
                    </div>
                    {% endfor %}
                    {% endif %}

                    <!-- Missing Categories -->
                    {% if video.criminal_analysis.missing_categories %}
                    <div style="background-color: #fff3cd; padding: 15px; margin-top: 20px; border-left: 4px solid #ffc107;">
                        <div class="meta-label">Missing Evidence Categories</div>
                        <p style="margin: 5px 0; font-size: 13px;">The following expected criminal evidence categories were not identified in this video:</p>
                        <ul style="margin: 5px 0; padding-left: 20px; font-size: 13px;">
                            {% for category in video.criminal_analysis.missing_categories %}
                            <li>{{ category }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                </div>

                {% else %}
                <!-- Standard Video Analysis for Non-Criminal Cases -->
                <div style="margin-bottom: 20px;">
                    <h5 style="color: #333; margin-bottom: 10px; font-family: 'Georgia', serif;">Comprehensive Video Analysis</h5>

                    {% if video.transcript %}
                    <div style="margin-bottom: 15px;">
                        <div class="meta-label">Audio Transcript</div>
                        <p style="margin: 5px 0; font-size: 13px; background-color: #f8f9fa; padding: 10px; border-radius: 3px;">{{ video.transcript }}</p>
                    </div>
                    {% endif %}

                    <!-- Enhanced Events Analysis with Timestamps and Relevance -->
                    {% if video.insights %}
                        {% if video.insights.events %}
                        <div style="margin-bottom: 15px;">
                            <div class="meta-label">Timestamped Events Analysis</div>
                            {% for event in video.insights.events %}
                            <div style="margin-bottom: 12px; padding: 12px; background-color: #ffffff; border: 1px solid #e0e0e0; border-left: 4px solid #3498db; border-radius: 3px;">
                                {% if event.timestamp %}
                                <div style="font-weight: bold; color: #2c3e50; margin-bottom: 5px;">⏱ {{ event.timestamp }}</div>
                                {% endif %}
                                <div style="margin-bottom: 8px; font-size: 13px;">{{ event.description | default(event.event | default('Event recorded')) }}</div>
                                {% if event.relevance %}
                                <div style="font-size: 12px; color: #7f8c8d; font-style: italic; border-top: 1px solid #ecf0f1; padding-top: 5px;">
                                    <strong>Relevance:</strong> {{ event.relevance }}
                                </div>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                        {% elif video.insights.timeline or video.insights.key_events %}
                        <div style="margin-bottom: 15px;">
                            <div class="meta-label">Key Events Timeline</div>
                            <ul style="margin: 5px 0; padding-left: 20px; list-style-type: none;">
                                {% if video.insights.timeline %}
                                    {% for event in video.insights.timeline %}
                                    <li style="margin-bottom: 8px; padding: 8px; background-color: #f8f9fa; border-left: 3px solid #3498db; border-radius: 3px;">
                                        {% if event is mapping %}
                                            {% if event.timestamp %}
                                                <strong style="color: #2c3e50;">{{ event.timestamp }}</strong> -
                                            {% endif %}
                                            {{ event.event|default(event.description|default('Event recorded')) }}
                                        {% else %}
                                            {{ event }}
                                        {% endif %}
                                    </li>
                                    {% endfor %}
                                {% elif video.insights.key_events %}
                                    {% for event in video.insights.key_events %}
                                    <li style="margin-bottom: 8px; padding: 8px; background-color: #f8f9fa; border-left: 3px solid #3498db; border-radius: 3px;">{{ event }}</li>
                                    {% endfor %}
                                {% endif %}
                            </ul>
                        </div>
                        {% endif %}
                    {% endif %}

                    {% if video.labels %}
                    <div style="margin-bottom: 15px;">
                        <div class="meta-label">Detected Content Labels</div>
                        <ul style="margin: 5px 0; padding-left: 20px; list-style-type: disc;">
                            {% for label in video.labels %}
                            <li style="margin-bottom: 5px; font-size: 13px;">{{ label }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}

                    {% if video.objects %}
                    <div style="margin-bottom: 15px;">
                        <div class="meta-label">Detected Objects and Evidence</div>
                        <ul style="margin: 5px 0; padding-left: 20px; list-style-type: disc;">
                            {% for object in video.objects %}
                            <li style="margin-bottom: 5px; font-size: 13px;">{{ object }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}

                    {% if video.text_annotations %}
                    <div style="margin-bottom: 15px;">
                        <div class="meta-label">Text Detected in Video</div>
                        <ul style="margin: 5px 0; padding-left: 20px; font-size: 13px;">
                            {% for text in video.text_annotations %}
                            <li style="margin-bottom: 5px; padding: 3px; background-color: #f8f9fa; border-radius: 2px;">{{ text }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}

                    {% if video.insights %}
                    <div style="margin-bottom: 15px;">
                        <div class="meta-label">Comprehensive Analysis</div>
                        <div style="margin: 5px 0; background-color: #f8f9fa; padding: 15px; border-radius: 3px; border-left: 4px solid #333;">
                            {{ results.format_video_analysis(video)|safe }}
                        </div>
                    </div>
                    {% endif %}

                    {% if video.duration %}
                    <div style="margin-bottom: 10px;">
                        <div class="meta-label">Video Duration</div>
                        <div class="meta-value">{{ "%.1f"|format(video.duration) }} seconds</div>
                    </div>
                    {% endif %}
                </div>
                {% endif %}

                <!-- Video File Metadata -->
                <div class="document-meta">
                    <div class="meta-item">
                        <div class="meta-label">File Name</div>
                        <div class="meta-value">{{ video.file_name }}</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Analysis Type</div>
                        <div class="meta-value">{{ "Criminal Law Analysis" if video.is_criminal_case else "Standard Video Analysis" }}</div>
                    </div>
                </div>

                <!-- Data Preservation Notice -->
                {% if video.insights_gcs_uri or video.insights_summary %}
                <div style="background-color: #e8f4fd; padding: 15px; margin-top: 15px; border-left: 4px solid #2196f3;">
                    <div class="meta-label">Data Preservation Notice</div>
                    <p style="margin: 5px 0; font-size: 12px;">
                        {% if video.insights_summary %}
                        Full video analysis data was preserved due to size limitations. Complete insights are available for detailed review.
                        {% endif %}
                        {% if video.insights_gcs_uri %}
                        Reference ID: {{ video.insights_gcs_uri.split('/')[-1] if '/' in video.insights_gcs_uri else video.insights_gcs_uri }}
                        {% endif %}
                    </p>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</body>
</html>
