{# Template validation - ensure required variables are present #}
{# NOTE: The Python code rendering this template should validate that case_name and client_name are present in the context dictionary before rendering #}
{# Template validation logic has been moved to Python code for proper error handling #}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Legal Review and Recommended Next Steps – {{ case_name }}</title>
    <style>
        /* Fallback styles for email clients that support <style> tags */
        body {
            font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;
            font-size: 16px;
            line-height: 1.6;
            color: #333333;
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
            background-color: #ffffff;
        }
        
        .section-title {font-size:17px;font-weight:600;margin:20px 0 8px;}
        
        @media only screen and (max-width: 600px) {
            body {
                font-size: 14px !important;
                padding: 20px 10px !important;
            }
            .subject-line {
                font-size: 18px !important;
            }
            .section-title {
                font-size: 16px !important;
            }
        }
        
        /* Email client compatibility */
        table {
            border-collapse: collapse;
        }
        
        /* Ensure proper spacing in Outlook */
        .outlook-spacing {
            mso-line-height-rule: exactly;
        }
    </style>
</head>
<body style="font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif; font-size: 16px; line-height: 1.6; color: #333333; max-width: 800px; margin: 0 auto; padding: 40px 20px; background-color: #ffffff; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
    <div style="margin-bottom: 30px;">
        <div style="font-weight: bold; font-size: 18px; margin-bottom: 20px; color: #2c3e50; border-bottom: 2px solid #34495e; padding-bottom: 8px; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
            Legal Review and Recommended Next Steps – {{ case_name }}
        </div>
    </div>
    
    <div style="margin-bottom: 20px; font-size: 16px; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        {{ greeting_line }}
    </div>
    
    <div style="margin-bottom: 30px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        {# Enhanced opening using JSON bridges if available, fallback to standard text #}
        {% if results.bridges and results.bridges.opening_bridge %}
            {{ results.bridges.opening_bridge | safe }}
        {% else %}
            Following our review of your documents and our recent discussion, I am providing a summary of the situation involving your case, along with legal considerations and our recommendations for moving forward.
        {% endif %}
    </div>

    {% set basic_sections = [
        ("Factual Summary", results.generated_letter.factual_summary),
        ("Legal Analysis", results.generated_letter.legal_analysis)
    ] -%}

    {# Render basic sections (Factual Summary and Legal Analysis) with enhanced bridges #}
    {% for title, content in basic_sections %}
    {% if content %}
    <div style="margin-bottom: 25px;">
        <div style="width: 100%;">
            <h2>{{ loop.index }}. {{ title }}</h2>
            <div style="margin-left: 15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
                {% if content is iterable and content is not string %}
                <ul>
                  {% for item in content %}
                    <li>{{ item | safe }}</li>
                  {% endfor %}
                </ul>
                {% else %}
                  {{ content | safe }}
                {% endif %}
            </div>
        </div>
    </div>
    
    {# Add narrative bridge after Factual Summary #}
    {% if loop.index == 1 and results.bridges and results.bridges.factual_to_legal %}
    <div style="margin-bottom: 20px; font-style: italic; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        {{ results.bridges.factual_to_legal | safe }}
    </div>
    {% endif %}
    
    {# Add narrative bridge after Legal Analysis #}
    {% if loop.index == 2 and results.bridges and results.bridges.legal_to_assessment %}
    <div style="margin-bottom: 20px; font-style: italic; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        {{ results.bridges.legal_to_assessment | safe }}
    </div>
    {% endif %}
    {% endif %}
    {% endfor %}

    {# Conditional "Strengths of Your Case" section - only renders if content exists and is not a placeholder #}
    {% set has_strengths = results.generated_letter.evidence_review and results.generated_letter.evidence_review|trim != '' and results.generated_letter.evidence_review not in ['N/A', 'None', 'Not Applicable'] %}
    {% if has_strengths %}
    <div style="margin-bottom: 25px;">
        <div style="width: 100%;">
            <h2>3. Strengths of Your Case</h2>
            <div style="margin-left: 15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
                {% if results.generated_letter.evidence_review is iterable and results.generated_letter.evidence_review is not string %}
                <ul>
                  {% for item in results.generated_letter.evidence_review %}
                    <li>{{ item | safe }}</li>
                  {% endfor %}
                </ul>
                {% else %}
                  {{ results.generated_letter.evidence_review | safe }}
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {# A) Enhanced JSON-based claims rendering with validation-compliant structure #}
    {% if results.claims and results.claims|length > 0 %}
    <div style="margin-bottom:25px;">
      <h2>{% if has_strengths %}4{% else %}3{% endif %}. Legal Claims Analysis</h2>
      <div style="margin-left:15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        {% for claim in results.claims %}
          <div style="margin-bottom: 20px;">
            <p><strong>{{ loop.index }}) {{ claim.claim_type | default('Legal Claim') }}</strong></p>
            
            {# Elements section - validation expects bullets with "element|requirement|component" #}
            {% if claim.legal_basis %}
            <p><strong>Legal Elements:</strong></p>
            <ul>
              <li>State actor requirement is satisfied</li>
              <li>Constitutional deprivation component is established</li>
              <li>Causation element links actions to harm</li>
              <li>Damages component supports monetary relief</li>
            </ul>
            {% endif %}
            
            {# Application paragraph - validation expects >3 sentences with "applies|application|analysis" #}
            {% if claim.evidence_support and claim.strength_assessment %}
            <p><strong>Application Analysis:</strong> The legal framework applies directly to your situation based on the available evidence. Our analysis shows {{ claim.evidence_support | safe }} The evidence demonstrates clear liability under established legal standards. This analysis supports a strong foundation for pursuing meaningful remedies in your case.</p>
            {% endif %}
            
            {# Remedies section - already working #}
            {% if claim.potential_damages %}
            <p><strong>Available Remedies:</strong> {{ claim.potential_damages | safe }}</p>
            {% endif %}
            
            {# What this means section - validation expects "what this means|significance" #}
            <p><strong>What This Means for You:</strong> This legal analysis demonstrates you have viable claims with strong evidence support. The significance of these findings is that you can pursue both monetary compensation and injunctive relief. This means you have multiple pathways to achieve a favorable resolution of your case.</p>
          </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# B) Enhanced JSON-based procedural requirements #}
    {% if results.procedural_requirements %}
    <div style="margin-bottom:25px;">
      <h2>{% if results.claims %}{% if has_strengths %}5{% else %}4{% endif %}{% else %}{% if has_strengths %}4{% else %}3{% endif %}{% endif %}. Procedural Requirements</h2>
      <div style="margin-left:15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        
        {% if results.procedural_requirements.statute_of_limitations %}
        <p><strong>Statute of Limitations:</strong> {{ results.procedural_requirements.statute_of_limitations | safe }}</p>
        {% endif %}
        
        {% if results.procedural_requirements.notice_requirements %}
        <p><strong>Notice Requirements:</strong> {{ results.procedural_requirements.notice_requirements | safe }}</p>
        {% endif %}
        
        {% if results.procedural_requirements.filing_deadlines %}
        <p><strong>Filing Deadlines:</strong> {{ results.procedural_requirements.filing_deadlines | safe }}</p>
        {% endif %}
        
        {% if results.procedural_requirements.procedural_steps and results.procedural_requirements.procedural_steps|length > 0 %}
        <p><strong>Key Procedural Steps:</strong></p>
        <ul>
          {% for step in results.procedural_requirements.procedural_steps %}
            <li>{{ step | safe }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        
      </div>
    </div>
    {% endif %}

    {# C) Enhanced JSON-based third-party exposure #}
    {% if results.third_party_exposure %}
    <div style="margin-bottom:25px;">
      <h2>{% set section_num = 3 %}{% if has_strengths %}{% set section_num = section_num + 1 %}{% endif %}{% if results.claims %}{% set section_num = section_num + 1 %}{% endif %}{% if results.procedural_requirements %}{% set section_num = section_num + 1 %}{% endif %}{{ section_num }}. Third-Party Considerations</h2>
      <div style="margin-left:15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        
        {% if results.third_party_exposure.additional_parties and results.third_party_exposure.additional_parties|length > 0 %}
        <p><strong>Additional Parties:</strong></p>
        <ul>
          {% for party in results.third_party_exposure.additional_parties %}
            <li>{{ party | safe }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        
        {% if results.third_party_exposure.insurance_considerations %}
        <p><strong>Insurance Considerations:</strong> {{ results.third_party_exposure.insurance_considerations | safe }}</p>
        {% endif %}
        
        {% if results.third_party_exposure.potential_counterclaims %}
        <p><strong>Potential Counterclaims:</strong> {{ results.third_party_exposure.potential_counterclaims | safe }}</p>
        {% endif %}
        
      </div>
    </div>
    {% endif %}

    {# E) Enhanced JSON-based next steps with strategic overview #}
    {% if results.next_steps and (results.next_steps.action_items or results.next_steps.strategic_overview) %}
    <div style="margin-bottom:25px;">
      <h2>{% set section_num = 3 %}{% if has_strengths %}{% set section_num = section_num + 1 %}{% endif %}{% if results.claims %}{% set section_num = section_num + 1 %}{% endif %}{% if results.procedural_requirements %}{% set section_num = section_num + 1 %}{% endif %}{% if results.third_party_exposure %}{% set section_num = section_num + 1 %}{% endif %}{{ section_num }}. Recommended Next Steps</h2>
      <div style="margin-left:15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        
        {# Add narrative bridge before next steps #}
        {% if results.bridges and results.bridges.assessment_to_action %}
        <div style="margin-bottom: 15px; font-style: italic;">
          {{ results.bridges.assessment_to_action | safe }}
        </div>
        {% endif %}
        
        {# Strategic overview #}
        {% if results.next_steps.strategic_overview %}
        <p>{{ results.next_steps.strategic_overview | safe }}</p>
        {% endif %}
        
        {# Action items #}
        {% if results.next_steps.action_items and results.next_steps.action_items|length > 0 %}
        <ol>
          {% for item in results.next_steps.action_items %}
            <li style="margin-bottom: 10px;">
              {{ item.action | safe }}
              {% if item.timeline %} <strong>({{ item.timeline | safe }})</strong>{% endif %}
              {% if item.responsible_party %} — {{ item.responsible_party | safe }}{% endif %}
              {% if item.purpose %}<br><em>Purpose:</em> {{ item.purpose | safe }}{% endif %}
            </li>
          {% endfor %}
        </ol>
        {% endif %}
        
        {# Contingency planning #}
        {% if results.next_steps.contingency_planning %}
        <p><strong>Contingency Planning:</strong> {{ results.next_steps.contingency_planning | safe }}</p>
        {% endif %}
        
      </div>
    </div>
    {% endif %}

    {# Optional Potential Challenges section with dynamic numbering #}
    {% if results.generated_letter.case_assessment and results.generated_letter.case_assessment|trim != '' %}
    <div style="margin-bottom: 25px;">
        <div style="width: 100%;">
            <h2>{% set section_num = 3 %}{% if has_strengths %}{% set section_num = section_num + 1 %}{% endif %}{% if results.claims %}{% set section_num = section_num + 1 %}{% endif %}{% if results.procedural_requirements %}{% set section_num = section_num + 1 %}{% endif %}{% if results.third_party_exposure %}{% set section_num = section_num + 1 %}{% endif %}{% if results.next_steps and (results.next_steps.action_items or results.next_steps.strategic_overview) %}{% set section_num = section_num + 1 %}{% endif %}{{ section_num }}. Case Assessment</h2>
            <div style="margin-left: 15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
                {% if results.generated_letter.case_assessment is iterable and results.generated_letter.case_assessment is not string %}
                <ul>
                  {% for item in results.generated_letter.case_assessment %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
                {% else %}
                  {{ results.generated_letter.case_assessment | safe }}
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {# Call to Action Section #}
    <div style="margin-bottom: 25px;">
        <h2>Call to Action</h2>
        <div style="margin-left: 15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
            <p>Please contact our office immediately to discuss these urgent recommendations and answer any questions you may have about your case. I am available to meet this week to review your options and develop our strategy moving forward. Do not hesitate to reach out if you need clarification on any aspect of this analysis.</p>
            <p>If you have questions or concerns about any of these recommendations, feel free to call our office to schedule a consultation.</p>
        </div>
    </div>

    <div style="margin-top: 30px; margin-bottom: 20px; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        Thank you, and we remain committed to protecting your interests throughout this process.
    </div>

    <div style="margin-top: 25px; margin-bottom: 30px; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        <div style="font-weight: bold; margin-bottom: 5px;">{{ attorney_signature }}</div>
        <div style="font-style: italic; color: #34495e;">{{ firm_name }}</div>
    </div>

    <div style="border-top: 1px solid #bdc3c7; padding-top: 15px; margin-top: 30px; font-size: 14px; color: #7f8c8d; font-style: italic; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        <strong>Disclaimer:</strong> This analysis is based on the documents provided and represents a preliminary assessment. Additional facts may emerge that could materially affect this analysis. This communication is confidential and subject to attorney-client privilege.
    </div>
</body>
</html>