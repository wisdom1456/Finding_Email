<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Legal Findings Letter</title>
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .letterhead {
            text-align: left;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #2c3e50;
        }
        .letterhead h1 {
            font-family: 'Georgia', serif;
            color: #2c3e50;
            font-size: 24px;
            margin: 0 0 10px 0;
        }
        .header-info {
            margin-bottom: 30px;
            font-size: 14px;
        }
        .header-info p {
            margin: 5px 0;
        }
        .section {
            margin-bottom: 30px;
            page-break-inside: avoid;
        }
        .section h2 {
            font-family: 'Georgia', serif;
            color: #2c3e50;
            font-size: 18px;
            margin-bottom: 15px;
            padding-bottom: 5px;
            border-bottom: 1px solid #bdc3c7;
        }
        .section h3 {
            font-family: 'Georgia', serif;
            color: #34495e;
            font-size: 16px;
            margin-bottom: 10px;
            margin-top: 20px;
        }
        .executive-summary {
            padding: 20px;
            margin-bottom: 30px;
        }
        .executive-summary h2 {
            color: #333;
            margin-top: 0;
        }
        .strengths-section {
            padding: 15px;
            margin-bottom: 20px;
        }
        .challenges-section {
            padding: 15px;
            margin-bottom: 20px;
        }
        .recommendations-section {
            padding: 15px;
            margin-bottom: 20px;
        }
        ul, ol {
            margin-left: 25px;
            margin-bottom: 15px;
        }
        li {
            margin-bottom: 8px;
            text-align: justify;
        }
        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #bdc3c7;
            font-style: italic;
        }
        .signature-block {
            margin-top: 30px;
        }
        .signature-block p {
            margin: 5px 0;
        }
        @media print {
            .container {
                box-shadow: none;
                padding: 20px;
            }
            .section {
                page-break-inside: avoid;
            }
        }
        /* Professional formatting for legal content */
        .legal-content p {
            text-align: justify;
            margin-bottom: 12px;
        }
        .legal-content ul {
            list-style-type: disc;
        }
        .legal-content ol {
            list-style-type: decimal;
        }
        .highlight {
            padding: 2px 4px;
            border-radius: 2px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header Section -->
        <div class="letterhead">
            <h1>Legal Findings Letter</h1>
        </div>

        <div class="header-info">
            <p><strong>Date:</strong> {{ current_date | default('Not Available') }}</p>
            <p><strong>To:</strong> {{ results.analysis.intake_analysis.client_name | default('Not Available') }}</p>
            <p><strong>From:</strong> {{ results.analysis.intake_analysis.attorney_name | default('Not Available') }}</p>
            <p><strong>Re:</strong> Case Analysis and Findings</p>
        </div>

        <!-- Executive Summary Section -->
        {% if results.generated_letter and results.generated_letter.executive_summary %}
        <div class="executive-summary">
            <h2>Executive Summary</h2>
            <div class="legal-content">
                {{ results.generated_letter.executive_summary | safe }}
            </div>
        </div>
        {% endif %}

        <!-- Background Summary Section -->
        {% if results.generated_letter and results.generated_letter.background_summary %}
        <div class="section">
            <h2>I. Background</h2>
            <div class="legal-content">
                {{ results.generated_letter.background_summary | safe }}
            </div>
        </div>
        {% endif %}

        <!-- Analysis and Position Section -->
        {% if results.generated_letter and results.generated_letter.analysis_and_position %}
        <div class="section">
            <h2>II. Legal Analysis and Position</h2>
            <div class="legal-content">
                {{ results.generated_letter.analysis_and_position | safe }}
            </div>
        </div>
        {% endif %}

        <!-- Media Analysis Section -->
        {% if results.generated_letter and results.generated_letter.media_summary %}
        <div class="section">
            <h2>III. Media Analysis</h2>
            <div class="legal-content">
                {{ results.generated_letter.media_summary | safe }}
            </div>
        </div>
        {% endif %}

        <!-- Video Analysis Appendix Section -->
        {% if results.generated_letter and results.generated_letter.video_analysis_appendix %}
        <div class="section">
            <div class="legal-content">
                {{ results.generated_letter.video_analysis_appendix | safe }}
            </div>
        </div>
        {% endif %}

        <!-- Case Strengths Section -->
        {% if results.generated_letter and results.generated_letter.strengths %}
        <div class="section">
            <h2>IV. Case Strengths</h2>
            <div class="strengths-section">
                <div class="legal-content">
                    {{ results.generated_letter.strengths | safe }}
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Potential Challenges Section -->
        {% if results.generated_letter and results.generated_letter.challenges %}
        <div class="section">
            <h2>V. Potential Challenges and Risks</h2>
            <div class="challenges-section">
                <div class="legal-content">
                    {{ results.generated_letter.challenges | safe }}
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Recommendations Section -->
        {% if results.generated_letter and results.generated_letter.recommendations %}
        <div class="section">
            <h2>VI. Recommendations</h2>
            <div class="recommendations-section">
                <div class="legal-content">
                    {{ results.generated_letter.recommendations | safe }}
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Next Steps Section -->
        {% if results.generated_letter and results.generated_letter.next_steps %}
        <div class="section">
            <h2>VII. Next Steps</h2>
            <div class="legal-content">
                {{ results.generated_letter.next_steps | safe }}
            </div>
        </div>
        {% endif %}

        <!-- Closing Paragraph Section -->
        {% if results.generated_letter and results.generated_letter.closing_paragraph %}
        <div class="section">
            <div class="legal-content">
                {{ results.generated_letter.closing_paragraph | safe }}
            </div>
        </div>
        {% endif %}

        <!-- Footer Section -->
        <div class="footer">
            <div class="signature-block">
                <p>Sincerely,</p>
                <p>{{ results.analysis.intake_analysis.attorney_name | default('[Attorney Name]') }}</p>
                <p>[Firm Name]</p>
                <p>[Firm Address]</p>
                <p>[Contact Information]</p>
            </div>
            
            <p style="margin-top: 30px; font-size: 12px; color: #7f8c8d;">
                <strong>Disclaimer:</strong> This analysis is based on the documents provided and represents a preliminary assessment. 
                Additional facts may emerge that could materially affect this analysis. This communication is confidential and 
                subject to attorney-client privilege.
            </p>
        </div>
    </div>
</body>
</html>