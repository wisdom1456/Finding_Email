{# Template validation - ensure required variables are present #}
{# NOTE: The Python code rendering this template should validate that case_name and client_name are present in the context dictionary before rendering #}
{# Template validation logic has been moved to Python code for proper error handling #}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Legal Review and Recommended Next Steps – {{ case_name }}</title>
    <style>
        /* Fallback styles for email clients that support <style> tags */
        body {
            font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;
            font-size: 16px;
            line-height: 1.6;
            color: #333333;
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
            background-color: #ffffff;
        }
        
        .section-title {font-size:17px;font-weight:600;margin:20px 0 8px;}
        
        @media only screen and (max-width: 600px) {
            body {
                font-size: 14px !important;
                padding: 20px 10px !important;
            }
            .subject-line {
                font-size: 18px !important;
            }
            .section-title {
                font-size: 16px !important;
            }
        }
        
        /* Email client compatibility */
        table {
            border-collapse: collapse;
        }
        
        /* Ensure proper spacing in Outlook */
        .outlook-spacing {
            mso-line-height-rule: exactly;
        }
    </style>
</head>
<body style="font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif; font-size: 16px; line-height: 1.6; color: #333333; max-width: 800px; margin: 0 auto; padding: 40px 20px; background-color: #ffffff; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
    <div style="margin-bottom: 30px;">
        <div style="font-weight: bold; font-size: 18px; margin-bottom: 20px; color: #2c3e50; border-bottom: 2px solid #34495e; padding-bottom: 8px; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
            Legal Review and Recommended Next Steps – {{ case_name }}
        </div>
    </div>
    
    <div style="margin-bottom: 20px; font-size: 16px; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        {{ greeting_line }}
    </div>
    
    <div style="margin-bottom: 30px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        Following our review of your documents and our recent discussion, I am providing a summary of the situation involving your case, along with legal considerations and our recommendations for moving forward.
    </div>

    {% set basic_sections = [
        ("Factual Summary", results.generated_letter.background_summary),
        ("Legal Analysis", results.generated_letter.analysis_and_position)
    ] -%}

    {# Render basic sections (Factual Summary and Legal Analysis) #}
    {% for title, content in basic_sections %}
    {% if content %}
    <div style="margin-bottom: 25px;">
        <div style="width: 100%;">
            <div class="section-title">{{ loop.index }}. {{ title }}</div>
            <div style="margin-left: 15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
                {% if content is iterable and content is not string %}
                <ul>
                  {% for item in content %}
                    <li>{{ item | safe }}</li>
                  {% endfor %}
                </ul>
                {% else %}
                  {{ content | safe }}
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}
    {% endfor %}

    {# Conditional "Strengths of Your Case" section - only renders if content exists and is not a placeholder #}
    {% set has_strengths = results.generated_letter.strengths and results.generated_letter.strengths|trim != '' and results.generated_letter.strengths not in ['N/A', 'None', 'Not Applicable'] %}
    {% if has_strengths %}
    <div style="margin-bottom: 25px;">
        <div style="width: 100%;">
            <div class="section-title">3. Strengths of Your Case</div>
            <div style="margin-left: 15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
                {% if results.generated_letter.strengths is iterable and results.generated_letter.strengths is not string %}
                <ul>
                  {% for item in results.generated_letter.strengths %}
                    <li>{{ item | safe }}</li>
                  {% endfor %}
                </ul>
                {% else %}
                  {{ results.generated_letter.strengths | safe }}
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {# A) Render modular claims (practice-agnostic) #}
    {% if results.claims %}
    <div style="margin-bottom:25px;">
      <div class="section-title">{% if has_strengths %}4{% else %}3{% endif %}. Legal Theories and Application</div>
      <div style="margin-left:15px; text-align: justify;">
        {% for c in results.claims %}
          <p><strong>{{ loop.index }}) {{ c.name }}</strong></p>
          {% if c.elements %}
            <ul>
              {% for e in c.elements %}<li>{{ e }}</li>{% endfor %}
            </ul>
          {% endif %}
          {% if c.application %}<p>{{ c.application }}</p>{% endif %}
          {% if c.remedies %}
            <p><strong>Potential remedies:</strong></p>
            <ul>
              {% for r in c.remedies %}<li>{{ r }}</li>{% endfor %}
            </ul>
          {% endif %}
          {% if c.client_risks %}<p><em>What this means for you:</em> {{ c.client_risks }}</p>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# B) Procedural requirements (generic) #}
    {% if results.procedural_requirements %}
    <div style="margin-bottom:25px;">
      <div class="section-title">{% if results.claims %}{% if has_strengths %}5{% else %}4{% endif %}{% else %}{% if has_strengths %}4{% else %}3{% endif %}{% endif %}. Procedural Requirements</div>
      <div style="margin-left:15px; text-align: justify;">
        {% for p in results.procedural_requirements %}
          <p><strong>{{ p.name }}</strong> — Typical timeline: {{ p.typical_timeline }}</p>
          {% if p.steps %}
          <ul>
            {% for s in p.steps %}<li>{{ s }}</li>{% endfor %}
          </ul>
          {% endif %}
          {% if p.consequence_if_ignored %}<p><em>Consequence if ignored:</em> {{ p.consequence_if_ignored }}</p>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# C) Third-party exposure (generic "lien risk" analog) #}
    {% if results.third_party_exposure %}
    <div style="margin-bottom:25px;">
      <div class="section-title">{% set section_num = 3 %}{% if has_strengths %}{% set section_num = section_num + 1 %}{% endif %}{% if results.claims %}{% set section_num = section_num + 1 %}{% endif %}{% if results.procedural_requirements %}{% set section_num = section_num + 1 %}{% endif %}{{ section_num }}. Third-Party Exposure</div>
      <div style="margin-left:15px; text-align: justify;">
        <ul>
          {% for t in results.third_party_exposure %}
            <li><strong>{{ t.party }}:</strong> {{ t.basis }} — Risk: {{ t.risk }}. Mitigation: {{ t.mitigation_action }}.</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}

    {# E) Next Steps - Enhanced version with purpose, deadline, and consequence #}
    {% if results.next_steps and results.next_steps.items %}
    <div style="margin-bottom:25px;">
      <div class="section-title">{% set section_num = 3 %}{% if has_strengths %}{% set section_num = section_num + 1 %}{% endif %}{% if results.claims %}{% set section_num = section_num + 1 %}{% endif %}{% if results.procedural_requirements %}{% set section_num = section_num + 1 %}{% endif %}{% if results.third_party_exposure %}{% set section_num = section_num + 1 %}{% endif %}{{ section_num }}. Recommended Next Steps</div>
      <div style="margin-left:15px; text-align: justify;">
        <p>We recommend the following sequence to control risk and build leverage.</p>
        <ol>
          {% for n in results.next_steps.items %}
            <li>
              {{ n.action }} <strong>within {{ n.deadline_days_from_trigger }} days</strong> of {{ n.trigger }} (Owner: {{ n.owner }}).
              Success: {{ n.success_criteria }}.
              {% if n.consequence_if_missed %} Consequence if missed: {{ n.consequence_if_missed }}.{% endif %}
            </li>
          {% endfor %}
        </ol>
      </div>
    </div>
    {% endif %}

    {# Fallback to legacy next steps if new structure not available #}
    {% if not (results.next_steps and results.next_steps.items) and results.generated_letter.next_steps %}
    <div style="margin-bottom: 25px;">
        <div style="width: 100%;">
            <div class="section-title">{% set section_num = 3 %}{% if has_strengths %}{% set section_num = section_num + 1 %}{% endif %}{% if results.claims %}{% set section_num = section_num + 1 %}{% endif %}{% if results.procedural_requirements %}{% set section_num = section_num + 1 %}{% endif %}{% if results.third_party_exposure %}{% set section_num = section_num + 1 %}{% endif %}{{ section_num }}. Recommended Next Steps</div>
            <div style="margin-left: 15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
                {% if results.generated_letter.next_steps is iterable and results.generated_letter.next_steps is not string %}
                <ul>
                  {% for item in results.generated_letter.next_steps %}
                    <li>{{ item | safe }}</li>
                  {% endfor %}
                </ul>
                {% else %}
                  {{ results.generated_letter.next_steps | safe }}
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {# Optional Potential Challenges section with dynamic numbering #}
    {% if results.generated_letter.challenges and results.generated_letter.challenges|trim != '' %}
    <div style="margin-bottom: 25px;">
        <div style="width: 100%;">
            <div class="section-title">{% set section_num = 3 %}{% if has_strengths %}{% set section_num = section_num + 1 %}{% endif %}{% if results.claims %}{% set section_num = section_num + 1 %}{% endif %}{% if results.procedural_requirements %}{% set section_num = section_num + 1 %}{% endif %}{% if results.third_party_exposure %}{% set section_num = section_num + 1 %}{% endif %}{% if (results.next_steps and results.next_steps.items) or results.generated_letter.next_steps %}{% set section_num = section_num + 1 %}{% endif %}{{ section_num }}. Potential Challenges</div>
            <div style="margin-left: 15px; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
                {% if results.generated_letter.challenges is iterable and results.generated_letter.challenges is not string %}
                <ul>
                  {% for item in results.generated_letter.challenges %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
                {% else %}
                  {{ results.generated_letter.challenges | safe }}
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    <div style="margin-top: 30px; margin-bottom: 20px; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        Thank you, and we remain committed to protecting your interests throughout this process.
    </div>

    <div style="margin-top: 25px; margin-bottom: 30px; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        <div style="font-weight: bold; margin-bottom: 5px;">{{ attorney_signature }}</div>
        <div style="font-style: italic; color: #34495e;">{{ firm_name }}</div>
    </div>

    <div style="border-top: 1px solid #bdc3c7; padding-top: 15px; margin-top: 30px; font-size: 14px; color: #7f8c8d; font-style: italic; text-align: justify; font-family: 'Times New Roman', 'Liberation Serif', 'DejaVu Serif', 'FreeSerif', Georgia, 'Nimbus Roman No9 L', serif;">
        <strong>Disclaimer:</strong> This analysis is based on the documents provided and represents a preliminary assessment. Additional facts may emerge that could materially affect this analysis. This communication is confidential and subject to attorney-client privilege.
    </div>
</body>
</html>