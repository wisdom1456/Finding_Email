# Frontend Environment Variables Example
# Copy this file to .env and fill in your actual values. Never commit the real .env.
# See ENV_SETUP.md for full setup instructions and feature-flag details.

# Supabase Configuration (Public - for client-side use)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL
PUBLIC_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Feature Flags (all default off/false; see ENV_SETUP.md "Feature Flags")
# ---------------------------------------------------------------------------

# When true, auto-runs bulk text extraction on case load and hides the
# Verification Hub bulk "Run OCR" button.
PUBLIC_ENABLE_AUTO_EXTRACT=false

# Default off. When true, auto-extract uses the convergent full-coverage loop
# instead of the legacy offset-paginated loop. Enable in a Vercel preview and
# verify a real case before turning it on in production.
PUBLIC_ENABLE_AUTO_EXTRACT_FULL_COVERAGE=false

# Trustworthy Wait Phase 1 UI (no Start during active run, honest progress).
# Backend status fields ship regardless; this only gates the frontend rendering.
PUBLIC_ENABLE_TRUSTWORTHY_WAIT=false
