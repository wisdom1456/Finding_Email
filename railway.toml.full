# Railway configuration for monorepo deployment
[build]
builder = "nixpacks"

[deploy]
numReplicas = 1

[[services]]
name = "backend"
root = "backend"
startCommand = "uvicorn main:app --host 0.0.0.0 --port $PORT"

[[services]]
name = "frontend"
root = "."
startCommand = "streamlit run app.py --server.port $PORT --server.address 0.0.0.0"
