{
  "framework": "sveltekit",
  "buildCommand": "bash scripts/vercel_build.sh",
  "functions": {
    "api/index.py": {
      "maxDuration": 800
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/monitor/worker",
      "schedule": "*/5 * * * *"
    }
  ]
}
